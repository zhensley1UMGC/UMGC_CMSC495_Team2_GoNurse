# Copy this file to .env and replace each password with a private local value.
# Use URL-safe alphanumeric passwords so they can be used in SQLAlchemy URLs.
GONURSE_PG_PORT=5432
GONURSE_POSTGRES_ADMIN_PASSWORD=replace_with_local_secret
GONURSE_APP_PASSWORD=replace_with_local_secret
GONURSE_APP_TEST_PASSWORD=replace_with_local_secret
GONURSE_BENCHMARK_PASSWORD=replace_with_local_secret
GONURSE_BENCHMARK_TEST_PASSWORD=replace_with_local_secret
