# Copy to .env and enter your own values. Never commit or share the .env file.
GONURSE_AI_MODEL=
GONURSE_AI_API_KEY=
# GONURSE_AI_BASE_URL=https://api.openai.com/v1
# GONURSE_AI_TIMEOUT_SECONDS=30
# GONURSE_AI_MAX_OUTPUT_TOKENS=1024

# Synthetic benchmark settings (separate from Navigator and the application database).
GONURSE_EMBEDDING_MODEL=text-embedding-3-small
GONURSE_EMBEDDING_API_KEY=
# GONURSE_EMBEDDING_BASE_URL=https://api.openai.com/v1
# GONURSE_EMBEDDING_TIMEOUT_SECONDS=30
# GONURSE_EMBEDDING_PRICE_PER_1M_TOKENS=0.02
# GONURSE_BENCHMARK_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/benchmark
# GONURSE_BENCHMARK_ALLOW_SCHEMA_CREATE=YES
